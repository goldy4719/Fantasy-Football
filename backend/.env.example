# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev_secret_key_change_in_production

# Local Dev Auth Bypass (Increment 2)
# Set to 'true' to allow mock user testing with X-Test-User-Id
ALLOW_AUTH_BYPASS=true
TEST_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase PostgreSQL Database URI (Direct Connection or Session Pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase API Configuration (Increment 3)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Tank01 / RapidAPI (Increment 3)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE